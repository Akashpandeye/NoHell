# --- Clerk (https://dashboard.clerk.com → API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: match your app routes (set in Clerk Dashboard → Paths too)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Vercel: add production URL (e.g. https://your-app.vercel.app) under
# Clerk → Domains / Authorized redirect URLs so sign-in works after deploy.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: service_role — never expose to the client; use in Vercel → Environment Variables → Production only or all envs as needed.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter (server only) ---
# Choose and pin a compatible Chat Completions model after evaluating
# NoHell's JSON-generation prompts.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=tencent/hy3:free

# YouTube captions: unofficial fetch often fails from cloud IPs (e.g. Vercel).
# Deploy tools/transcript-proxy separately and point the app at its HTTPS endpoint.
# URL must include /transcript (e.g. https://your-proxy.example.com/transcript).
YOUTUBE_TRANSCRIPT_PROVIDER_URL=
# Shared server-only bearer token; use the same value in the app and proxy service.
YOUTUBE_TRANSCRIPT_PROVIDER_TOKEN=
# Keep false on Vercel so a proxy failure does not trigger another request from a blocked cloud IP.
YOUTUBE_TRANSCRIPT_ALLOW_DIRECT_FALLBACK=false

# --- Transcript proxy service only (not needed by the Next.js process) ---
# Render provides PORT automatically; local/Docker default is 8787.
PORT=8787
YT_TRANSCRIPT_LANGUAGES=en
YT_TRANSCRIPT_PRESERVE_FORMATTING=false
YT_TRANSCRIPT_CACHE_TTL_SECONDS=300
YT_TRANSCRIPT_CACHE_MAX_ENTRIES=256
YT_TRANSCRIPT_RETRY_AFTER_SECONDS=30
# Preferred production option: Webshare rotating residential proxy.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# Optional comma-separated country codes, e.g. us,gb,de
WEBSHARE_FILTER_IP_LOCATIONS=
# Generic proxy fallback (used only when complete Webshare credentials are absent).
YT_HTTP_PROXY_URL=
YT_HTTPS_PROXY_URL=
# Optional Gunicorn tuning.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30

# --- Razorpay (optional; omit if not using payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_ORDER_CURRENCY=INR
# RAZORPAY_ORDER_AMOUNT_MINOR=59900
RAZORPAY_WEBHOOK_SECRET=
